# Application Configuration
APP_ENV=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# Security & Authentication
# IMPORTANT: Generate a strong secret in production: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite - Lightweight, Persistent)
DATABASE_URL=sqlite:///./data/app.db

# Vector Database (ChromaDB - Local Persistent)
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=ai_knowledge_assistant

# Embedding Model (Sentence Transformers - Lightweight ~90MB)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
LOW_RAM_MODE=True
EMBEDDING_BATCH_SIZE=16
TORCH_NUM_THREADS=2

# =============================================================================
# Cloud LLM Provider Layer (Low-RAM Architecture: 0MB Local LLM Overhead)
# =============================================================================
# Active provider: 'openai', 'groq', 'openrouter', 'gemini', 'deepseek', 'custom'
LLM_PROVIDER=openai

# 1. OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.1

# 2. Groq (Recommended for Fast & Free Tier Cloud Inference)
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# 3. OpenRouter (Free & Open Source Cloud Models)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# 4. Google Gemini (via OpenAI-compatible endpoint)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-1.5-flash

# 5. DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 6. Custom / Local Endpoint (e.g. Ollama for lightweight 0.5B/1B models)
CUSTOM_LLM_API_KEY=ollama-local
CUSTOM_LLM_BASE_URL=http://127.0.0.1:11434/v1
CUSTOM_LLM_MODEL=qwen2.5:0.5b

# Document Processing & RAG Parameters
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=15
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.20

# Frontend Configuration
FRONTEND_PORT=8501
BACKEND_API_URL=http://localhost:8000
