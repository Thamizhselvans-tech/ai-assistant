# ==============================================================================
# Environment Configuration Template for AI Knowledge Assistant
# Copy to .env for local development or set in Render / Cloud dashboard
# ==============================================================================

# Application Runtime
APP_ENV=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
# PORT is dynamically assigned by Render (e.g. 10000)

# Security & JWT Authentication
# In production, generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Persistent Storage Paths (Local or Render Persistent Disk)
# For Render Persistent Disk: set DATA_DIR=/var/data
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.db
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=ai_knowledge_assistant
UPLOAD_DIR=./data/uploads

# Embedding Engine (Sentence Transformers ~90MB)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
LOW_RAM_MODE=True
EMBEDDING_BATCH_SIZE=16
TORCH_NUM_THREADS=2

# Cloud LLM Provider Layer (Low-RAM Architecture)
# Options: 'gemini', 'openai', 'groq', 'openrouter', 'deepseek', 'custom'
AI_PROVIDER=gemini
LLM_PROVIDER=gemini

# 1. Google Gemini (Official Google GenAI SDK & Free Tier)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# 2. OpenAI (Optional Provider)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.1

# 3. Groq (Ultra-Fast Cloud Inference)
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# 4. OpenRouter (Free & Open Source Cloud Models)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Document Processing & RAG Parameters
MAX_UPLOAD_SIZE_MB=15
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.20

# CORS Allowed Origins (Comma-separated for frontend domains)
CORS_ORIGINS=https://*.streamlit.app,http://localhost:8501,http://127.0.0.1:8501

# Frontend Configuration (Used by Streamlit UI)
FRONTEND_PORT=8501
BACKEND_API_URL=http://localhost:8000
