# ==============================================================================
# Environment Configuration Template for AI Knowledge Assistant
# Copy this file to .env and configure your values.
# NEVER commit .env with real secrets to version control or Docker images.
# ==============================================================================

# Application Runtime
APP_ENV=production
DEBUG=False
API_HOST=0.0.0.0
API_PORT=8000
PORT=8080

# Security & Authentication (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage Paths & Mount Points
DATA_DIR=/app/data
DATABASE_URL=sqlite:////app/data/app.db
CHROMA_PERSIST_DIRECTORY=/app/chroma_data
CHROMA_COLLECTION_NAME=ai_knowledge_assistant
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=15

# Embedding Engine & RAM Optimization
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
LOW_RAM_MODE=True
EMBEDDING_BATCH_SIZE=16
TORCH_NUM_THREADS=2

# AI / LLM Provider Selection
# Options: gemini | openai | groq | openrouter | deepseek | custom
AI_PROVIDER=gemini
LLM_PROVIDER=gemini

# 1. Google Gemini (Official Google GenAI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 2. OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.1

# 3. Groq Cloud
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# 4. OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# 5. DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 6. Custom / Local LLM (e.g., Ollama)
CUSTOM_LLM_API_KEY=your_custom_api_key_if_required
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_MODEL=qwen2.5:0.5b

# Document Processing & RAG Pipeline
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.20

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=*

# Frontend Configuration
BACKEND_API_URL=http://backend:8000
API_BASE_URL=http://backend:8000
FRONTEND_PORT=8501
