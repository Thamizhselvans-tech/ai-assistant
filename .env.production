# ==============================================================================
# Production Environment Configuration Template
# COPY TO .env ON PRODUCTION SERVER AND UPDATE ALL VALUES
# ==============================================================================

# Application Runtime
APP_ENV=production
DEBUG=False
API_HOST=0.0.0.0
API_PORT=8000

# Security & Authentication
# CRITICAL: Generate a cryptographically secure 64-character secret key before deploying:
# Command: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=GENERATE_AND_REPLACE_WITH_STRONG_HEX_SECRET_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Persistent Storage Paths (Container Volume Mounts)
DATABASE_URL=sqlite:////app/data/app.db
CHROMA_PERSIST_DIRECTORY=/app/chroma_data
CHROMA_COLLECTION_NAME=ai_knowledge_assistant
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_SIZE_MB=15

# Embedding Engine (Sentence Transformers)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# OpenAI API Configuration
# Optional: provide your live OpenAI key for generative synthesis.
# If omitted or unconfigured, the pipeline provides grounded excerpt citations safely.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.1

# Document Processing & RAG Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.35

# CORS Configuration
# Set to your production domain(s) separated by commas, e.g., https://assistant.example.com
CORS_ORIGINS=https://localhost,http://localhost:8501

# Streamlit Frontend Settings
BACKEND_API_URL=http://backend:8000
FRONTEND_PORT=8501
