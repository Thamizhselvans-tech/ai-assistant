# ==============================================================================
# Docker Ignore for Root Project Context
# ==============================================================================

# Git and Version Control
.git/
.gitignore
.gitattributes

# Python Bytecode and Caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/

# Databases and Local Storage (mounted as volumes in containers)
data/
chroma_data/
*.db
*.sqlite
*.sqlite3
uploads/

# Secrets and Local Environment Files
.env
.env.*
*.env
secrets.toml
.streamlit/secrets.toml
*service-account*.json
*firebase*.json
*-adminsdk-*.json

# Logs and Debug Output
*.log
logs/
firebase-debug.log

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~

# OS Artifacts
Thumbs.db
Desktop.ini
.DS_Store
