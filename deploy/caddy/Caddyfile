# ==============================================================================
# Caddy Reverse Proxy Configuration for AI Knowledge Assistant
# Automated HTTPS (Let's Encrypt), HTTP/3 support, and WebSocket Upgrades
# ==============================================================================

assistant.example.com {
    # Encode responses with zstd and gzip
    encode zstd gzip

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Route /api/* and /docs to FastAPI Backend
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /docs* {
        reverse_proxy backend:8000
    }

    handle /openapi.json {
        reverse_proxy backend:8000
    }

    # Route all other traffic to Streamlit Frontend with WebSockets
    handle {
        reverse_proxy frontend:8501 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
